# Copy to .env for local testing only. .env is gitignored — never commit it.
# In GitHub Actions these come from repository Secrets.

# One key, or several separated by commas (rotated to stay under free-tier limits)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
# Groq (qwen/qwen3.8-27b is its only image model). Off by default: it misreads
# small Bangla print and invents headlines. Set GROQ_FALLBACK=true to allow it anyway.
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK=false
# Seconds to wait between Gemini calls (keeps under free-tier requests/minute)
GEMINI_DELAY_SECONDS=7
# en | bn | both
DIGEST_LANG=en

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Daily Star: email + password login
DAILYSTAR_EMAIL=
DAILYSTAR_PASSWORD=

# Prothom Alo: the site's own email + password login (auth.prothomalo.com)
PROTHOMALO_EMAIL=
PROTHOMALO_PASSWORD=
# Optional fallback if you ever switch back to Google login:
# base64 of a saved session (npm run save-session prothomalo)
PROTHOMALO_SESSION=
